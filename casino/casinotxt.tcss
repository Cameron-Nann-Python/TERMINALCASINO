Header {
    dock: top;
    height: 3;
    align: center middle;
}

#name_account {
    padding: 0 0;
    height: 4;
}

/*Styles the username box*/
#username {
    align: left middle;
    border: solid white;
    width: auto;
    padding: 0 2;
}

#spacer {
    width: 1fr;
}

#account_balance {
    align: right middle;
    border: solid white;
    width: auto;
    padding: 0 2;
}

/*Styles the Game Options*/
#game_content {
    width: 100%;
}

.games {
    width: 100%;
}

Footer {
    dock: bottom;
}